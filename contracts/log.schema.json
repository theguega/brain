{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.local/contracts/log.schema.json",
  "title": "C3 log block",
  "description": "One block of log/YYYY-MM-DD.md, parsed. The heading is `## <at> · <tz> · <place> · <source> · <title>`, with '-' for an unknown place.",
  "type": "object",
  "properties": {
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "tz": {
      "type": "string",
      "pattern": "^[A-Za-z]+(/[A-Za-z0-9_+-]+)*$"
    },
    "place": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "at",
    "tz",
    "place",
    "source",
    "title",
    "body"
  ],
  "additionalProperties": false
}
