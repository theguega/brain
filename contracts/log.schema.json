{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.local/contracts/log.schema.json",
  "version": 1,
  "title": "C3 log block",
  "description": "One block of log/YYYY-MM-DD.md, parsed. The heading is `## <at> · <tz> · <place> · <source> · <title>`, with '-' for an unknown place.",
  "type": "object",
  "properties": {
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "tz": {
      "type": "string",
      "pattern": "^[A-Za-z]+(/[A-Za-z0-9_+-]+)*$"
    },
    "place": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[^·\\r\\n]+$",
          "not": {
            "const": "-"
          },
          "description": "One field of a C3 heading: one line, no ' · ', and '-' is reserved for unknown."
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "pattern": "^[^\\r\\n]+$"
    },
    "body": {
      "type": "string",
      "description": "A line that reads as a block heading is stored with a leading backslash.",
      "not": {
        "pattern": "(^|\\n)## [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2} · "
      }
    }
  },
  "required": [
    "at",
    "tz",
    "place",
    "source",
    "title",
    "body"
  ],
  "additionalProperties": false
}
