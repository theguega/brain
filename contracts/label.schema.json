{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.local/contracts/label.schema.json",
  "version": 1,
  "title": "C7 label",
  "description": "One line of labels.jsonl.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(arxiv|web|file|meeting|artifact):[a-z0-9][a-z0-9.-]*$"
    },
    "verdict": {
      "enum": [
        "like",
        "skip",
        "later"
      ]
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "surface": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    }
  },
  "required": [
    "id",
    "verdict",
    "ts",
    "surface"
  ],
  "additionalProperties": false
}
