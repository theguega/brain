{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.local/contracts/page.schema.json",
  "version": 1,
  "title": "C2 page frontmatter",
  "description": "The YAML frontmatter of pages/<slug>.md, as JSON. A key whose values are wikilinks is a typed relation (`brain link` writes them), and any other key warns.",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "person",
        "project",
        "decision",
        "concept",
        "synthesis"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(arxiv|web|file|meeting|artifact):[a-z0-9][a-z0-9.-]*$"
      }
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2}))?$"
    },
    "superseded_by": {
      "type": "string",
      "pattern": "^\\[\\[[a-z0-9][a-z0-9-]{0,63}\\]\\]$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Other names; an exact match in `find` goes straight to the page."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Obsidian tags."
    }
  },
  "required": [
    "kind",
    "title",
    "summary",
    "status",
    "sources",
    "updated"
  ],
  "$comment": "Any other key is allowed: a wikilink-valued one is a relation, the rest make `brain lint` warn."
}
