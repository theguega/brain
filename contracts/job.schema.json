{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.local/contracts/job.schema.json",
  "title": "C10 job line",
  "description": "One line of jobs.jsonl, appended by every job run and every tick.",
  "type": "object",
  "properties": {
    "job": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "started": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ended": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ok": {
      "type": "boolean"
    },
    "err": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "job",
    "started",
    "ended",
    "ok",
    "err"
  ],
  "additionalProperties": false
}
