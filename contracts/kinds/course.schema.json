{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.local/contracts/kinds/course.schema.json",
  "version": 1,
  "title": "C1 doc: course",
  "description": "A course. Stored as docs/<id>/meta.json, where the directory name is the id with ':' replaced by '--'.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(arxiv|web|file|meeting|artifact):[a-z0-9][a-z0-9.-]*$"
    },
    "kind": {
      "const": "course"
    },
    "taint": {
      "enum": [
        "own",
        "external"
      ]
    },
    "added": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(/|~)"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "year": {
      "type": "integer"
    },
    "links": {
      "type": "object",
      "properties": {
        "home": {
          "type": "string",
          "pattern": "^https?://"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "kind",
    "taint",
    "added",
    "title",
    "authors",
    "year",
    "links"
  ],
  "additionalProperties": false
}
